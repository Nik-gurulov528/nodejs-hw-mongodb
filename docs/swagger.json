  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "contact": {
        "required": [
          "_id",
          "name",
          "phoneNumber",
          "isFavourite",
          "contactType",
          "ownerId",
          "photo",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "description": "Contact's id",
            "example": "6848983cae8cfce8ba56a779"
          },
          "name": {
            "type": "string",
            "description": "Contact's name",
            "example": "Sanya White"
          },
          "phoneNumber": {
            "type": "string",
            "description": "Contact's phonenumber",
            "example": "+380500502222"
          },
          "isFavourite": {
            "type": "boolean",
            "description": "Is this contact favourite",
            "example": true,
            "default": false
          },
          "contactType": {
            "type": "string",
            "description": "Type of contact's phoneNumber",
            "example": "home",
            "enum": [
              "work",
              "home",
              "personal"
            ]
          },
          "ownerId": {
            "type": "string",
            "description": "Contact's owner",
            "example": "6847fba0aca7ef6dc1f59158"
          },
          "photo": {
            "type": "string",
            "format": "url",
            "description": "Contact's avatar",
            "example": "https://res.cloudinary.com/dj2jac6qn/image/upload/v1750249291/ptpb3wiz9o0hqpeij7n5.jpg"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When was contact created",
            "example": "2025-06-09T13:51:12.268+00:00"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When was contact updated",
            "example": "2025-06-10T08:46:00.630+00:00"
          }
        }
      },
      "user": {
        "required": [
          "_id",
          "name",
          "email",
          "password",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "description": "User's id",
            "example": "6848983cae8cfce8ba56a779"
          },
          "name": {
            "type": "string",
            "description": "User's name",
            "example": "Maxim Padushka"
          },
          "email": {
            "type": "string",
            "description": "User's email",
            "example": "Maxwell85734@gmail.com"
          },
          "password": {
            "type": "string",
            "description": "User's password"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When was user created",
            "example": "2025-06-09T13:51:12.268+00:00"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When was user updated",
            "example": "2025-06-10T08:46:00.630+00:00"
          }
        }
      }
    },
    "responses": {
      "401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "status",
                "message",
                "data"
